# --- Local development (docker-compose, running functions outside OpenFaaS) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cofrap
DB_USER=cofrap

# Used by docker-compose and the functions when run locally.
MARIADB_ROOT_PASSWORD=rootpass
MARIADB_PASSWORD=cofrap_dev

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Optional override (defaults to 6 months in seconds)
# EXPIRY_SECONDS=15552000

# Optional override for TOTP provisioning URI issuer
# TOTP_ISSUER=COFRAP
