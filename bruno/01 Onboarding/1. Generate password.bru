meta {
  name: 1. Generate password
  type: http
  seq: 1
}

post {
  url: {{generate_password_url}}
  body: json
  auth: none
}

body:json {
  {
    "username": "{{username}}"
  }
}

script:post-response {
  // Stocke gendate dans l'environnement pour la suite.
  const body = res.getBody();
  if (body && body.gendate) {
    bru.setEnvVar("gendate", String(body.gendate));
  }
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("body returns the username", function() {
    expect(res.getBody().username).to.equal(bru.getVar("username"));
  });

  test("body returns a base64 PNG QR code", function() {
    const qr = res.getBody().qrcode_png_base64;
    expect(qr).to.be.a("string");
    expect(qr.length).to.be.greaterThan(100);
  });

  test("body returns gendate (unix seconds)", function() {
    const ts = res.getBody().gendate;
    expect(ts).to.be.a("number");
    expect(ts).to.be.greaterThan(1700000000);
  });
}

docs {
  Crée (ou réinitialise) le compte `username` avec un mot de passe de 24 caractères.

  La réponse contient le QR code PNG en base64 — à scanner pour récupérer le mot de passe en clair (une seule fois, comme prévu par le cahier des charges).

  Pour le tester côté navigateur :
  ```js
  const img = new Image();
  img.src = "data:image/png;base64," + body.qrcode_png_base64;
  document.body.appendChild(img);
  ```

  Après scan, coller le mot de passe dans la variable `password` de l'environnement pour pouvoir exécuter les requêtes d'authentification.
}
