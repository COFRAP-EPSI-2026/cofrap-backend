meta {
  name: Wrong password
  type: http
  seq: 2
}

post {
  url: {{authenticate_user_url}}
  body: json
  auth: none
}

body:json {
  {
    "username": "{{username}}",
    "password": "not-the-real-password-and-still-24!",
    "otp": "000000"
  }
}

tests {
  test("status is 401", function() {
    expect(res.getStatus()).to.equal(401);
  });

  test("detail mentions invalid credentials", function() {
    expect(res.getBody().detail).to.include("invalid credentials");
  });
}

docs {
  Mot de passe incorrect → 401. Le code OTP n'est jamais validé puisque le password échoue avant.
}
